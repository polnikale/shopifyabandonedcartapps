const path = '/alternatives/yotpo-email-sms-alternative';
const title = pageTitle(site, 'alternatives/yotpo-email-sms-alternative');
const desc = description(site, 'alternatives/yotpo-email-sms-alternative');
const faqs = [
  {
    question: 'Why leave Yotpo Email & SMS?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Suite breadth adds complexity; Best value with multiple Yotpo modules.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Use retained consent provenance and suppression exports; validate replacement cart events and purchaser exits, size a proposed holdout for available traffic, and reconcile queued sends and duplicate events. The retired SMS dashboard is unavailable; do not assume a fresh export remains possible.',
  },
  {
    question: 'Margin during migration?',
    answer: '$508 AOV at 56% margin yields $284.48 at full price and $208.28 after a 15% discount: $76.20 contribution lost, assuming unchanged product cost and excluding other variable costs.',
  },
  {
    question: 'Timeline?',
    answer: 'Treat 1–3 weeks as an illustrative planning window, not a measured migration benchmark. Missing retained exports, consent provenance or suppression records can change the schedule; validate replacement event ingestion and purchaser exits before sending.',
  },
  {
    question: 'SMS pairing?',
    answer: 'If evaluating Postscript or Recart, verify current Shopify event coverage, channel-specific permission and suppression exchange; test purchaser exits and collision rules before enabling sends.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Suppress recent purchasers; sunset unengaged.',
  },
  {
    question: 'When stay?',
    answer: 'Staying on the retired native Email and SMS products is not a current recovery option. Evaluate any continuing Reviews or Loyalty requirements separately; the messaging sunset does not establish the status of every Yotpo product or individual contract.',
  },
];
