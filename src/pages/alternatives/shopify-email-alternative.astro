---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('shopify-email')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/shopify-email-alternative';
const title = pageTitle(site, 'alternatives/shopify-email-alternative');
const desc = description(site, 'alternatives/shopify-email-alternative');
const faqs = [
  {
    question: 'Why leave Shopify Email?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Limited automation depth; No advanced segmentation.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Export consent records with their source and channel scope; rebuild and test cart events; propose a 5% randomized holdout only if sample size supports it; pause overlapping old automations after the replacement and purchase exits pass tests.',
  },
  {
    question: 'Margin during migration?',
    answer: '$715 AOV at 47% margin gives $336.05 before discount and $257.40 after an 11% discount, a $78.65 contribution loss with product cost fixed; exclude tax, shipping, fees and returns from this illustration.',
  },
  {
    question: 'Timeline?',
    answer: 'Use 1–3 weeks as a planning proposal, not a measured migration benchmark; scope depends on consent records, event mapping, suppression tests and rollback readiness.',
  },
  {
    question: 'SMS pairing?',
    answer: 'Evaluate native Shopify Messaging SMS eligibility before adding a provider. If considering Postscript or Recart, verify consent scope, shared suppression behavior and duplicate-send prevention in your own integration.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Test purchase suppression and unsubscribe propagation before enabling sends; define an engagement sunset window from your own deliverability and retention data.',
  },
  {
    question: 'When stay?',
    answer: 'Stay if eligible native Shopify Messaging email, SMS and automation workflows meet your operational requirements after testing; a need for SMS alone does not establish a need to migrate.',
  },
];
