import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('tinyemail')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/tinyemail-alternative';
const title = pageTitle(site, 'alternatives/tinyemail-alternative');
const desc = description(site, 'alternatives/tinyemail-alternative');
const faqs = [
  {
    question: 'Why leave tinyEmail?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Lighter automation depth; Not battle-tested for complex programs.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Export channel-specific consent and suppressions with provenance; rebuild cart events and purchaser exits; consider a proposed 5% holdout sized for your traffic; pause old automations, reconcile queued sends and deduplicate replayed events before cutover.',
  },
  {
    question: 'Margin during migration?',
    answer: '$795 AOV at 70% margin yields $556.50 at full price and $453.15 after a 13% discount: $103.35 contribution lost, assuming unchanged product cost and excluding other variable costs.',
  },
  {
    question: 'Timeline?',
    answer: 'Use 1–3 weeks as a proposed planning window, then adjust for consent mapping, suppression parity, event validation and queue cutover; this is not an observed migration benchmark.',
  },
  {
    question: 'SMS pairing?',
    answer: 'If evaluating Postscript or Recart for SMS, verify current Shopify event coverage, channel-specific permission, purchaser exits and suppression exchange before enabling sends; shared suppressions must be tested rather than assumed.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Suppress recent purchasers; sunset unengaged.',
  },
  {
    question: 'When stay?',
    answer: 'If Budget-sensitive shops wanting quick campaign drafting still matches ops.',
  },
];
