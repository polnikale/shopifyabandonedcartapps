---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('justuno')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/justuno-alternative';
const title = pageTitle(site, 'alternatives/justuno-alternative');
const desc = description(site, 'alternatives/justuno-alternative');
const faqs = [
  {
    question: 'Why leave Justuno?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Not primarily an email sender; Requires pairing with campaign tools.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Map the captured profile to the actual sending platform and channel-specific permission records; check current cart and purchase state; define one owner for queued sends; deduplicate replayed events; carry suppressions across systems. Use a proposed 5% holdout only with enough volume to interpret it.',
  },
  {
    question: 'Margin during migration?',
    answer: '$208 AOV — $145.6 vs 8% $128.96.',
  },
  {
    question: 'Timeline?',
    answer: 'Treat 1–3 weeks as a planning assumption, not a measured migration duration. Schedule cutover after identity, permission, queued-send ownership, suppression and event replay checks pass.',
  },
  {
    question: 'SMS pairing?',
    answer: 'Compare the intended SMS provider against your required markets and integration. Verify channel permission, current suppressions and queued-send ownership before enabling messages.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Recheck purchase and cart state before sending, preserve opt-outs and their scope, reconcile profile identifiers, and deduplicate delayed or replayed events. Review engagement against a documented retention policy.',
  },
  {
    question: 'When stay?',
    answer: 'Stay when the onsite capture and connected workflow configuration meets your requirements; evaluate the downstream sender separately before replacing either layer.',
  },
];
