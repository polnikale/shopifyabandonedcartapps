import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('omnisend')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/omnisend-alternative';
const title = pageTitle(site, 'alternatives/omnisend-alternative');
const desc = description(site, 'alternatives/omnisend-alternative');
const faqs = [
  {
    question: 'Why leave Omnisend?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Less flexible than Klaviyo for complex data; SMS costs need monitoring.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Privy.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Export consent and suppression records with their sources, timestamps and purposes; assign an owner to rebuild cart flows and validate current purchase, consent and unsubscribe state before activation. A 5% holdout is an illustrative design choice, subject to sample size. Pause old automations and inspect queued messages; replay only eligible events after deduplication and a fresh permission check.',
  },
  {
    question: 'Margin during migration?',
    answer: '$129 AOV at 32% margin gives $41.28 contribution at full price. With fixed product cost, a 9% discount gives $29.67 contribution, a loss of $11.61, before messaging and other variable costs.',
  },
  {
    question: 'Timeline?',
    answer: 'Use 1–3 weeks as an illustrative planning window, not an observed benchmark or delivery guarantee; ownership, data quality, permission review and queue reconciliation determine the actual schedule.',
  },
  {
    question: 'SMS pairing?',
    answer: 'Evaluate Postscript or Recart against current documented integration support. Assign an owner to verify shared suppressions, purpose-specific permission and current purchase state across channels before enabling sends; do not assume that a connection synchronizes every state.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Suppress recent purchasers; define a sunset policy for unengaged contacts. Keep suppression reasons and permission history, reconcile queued events against current state, and require an owner to approve any eligible replay after deduplication.',
  },
  {
    question: 'When stay?',
    answer: 'If SMB Shopify stores wanting multichannel automation without enterprise complexity still matches ops.',
  },
];
