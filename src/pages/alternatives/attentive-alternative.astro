---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('attentive')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/attentive-alternative';
const title = pageTitle(site, 'alternatives/attentive-alternative');
const desc = description(site, 'alternatives/attentive-alternative');
const faqs = [
  {
    question: 'Why leave Attentive?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Custom pricing excludes tiny stores; Can be more platform than needed early.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Export consent; rebuild cart; holdout 5%; pause old automations.',
  },
  {
    question: 'Margin during migration?',
    answer: 'Illustrative $757 order at 56% gross margin: $333.08 fixed product cost, $423.92 full-price contribution; a 20% selling-price discount leaves $605.60 revenue and $272.52 contribution, a $151.40 reduction before other costs.',
  },
  {
    question: 'Timeline?',
    answer: 'Plan migration around consent validation, event checks, suppression tests and sufficient measurement data; elapsed time alone does not establish readiness.',
  },
  {
    question: 'SMS pairing?',
    answer: 'Evaluate Postscript or Recart; verify consent scope, integration support and shared purchase suppressions before pairing SMS.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Suppress recent purchasers; sunset unengaged.',
  },
  {
    question: 'When stay?',
    answer: 'If Larger DTC brands with high SMS volume still matches ops.',
  },
];
