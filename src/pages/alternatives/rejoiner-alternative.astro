import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('rejoiner')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/rejoiner-alternative';
const title = pageTitle(site, 'alternatives/rejoiner-alternative');
const desc = description(site, 'alternatives/rejoiner-alternative');
const faqs = [
  {
    question: 'Why leave Rejoiner?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Not cheap self-serve; Fit depends on service needs.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Export sender identity, purpose-specific permission evidence and current consent state; rebuild cart with a proposed 5% holdout; assign queued-message ownership, pause old automations and deduplicate replayed events before cutover.',
  },
  {
    question: 'Margin during migration?',
    answer: '$549 AOV at 39% margin gives $214.11 full-price contribution; an 18% discount leaves $115.29, a $98.82 loss with product costs fixed, before messaging and platform fees.',
  },
  {
    question: 'Timeline?',
    answer: 'Use 1–3 weeks only as an illustrative planning window for a mid-size store; actual timing depends on data access, consent mapping, integration checks and queue reconciliation.',
  },
  {
    question: 'SMS pairing?',
    answer: 'Evaluate Postscript or Recart separately for the required SMS workflow; verify current integration support and sender-specific permission before assigning one owner per queued message and sharing purchase and opt-out suppressions.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Suppress recent purchasers; sunset unengaged contacts under a documented policy. Preserve sender identity, permission purpose, opt-outs and current consent state; an imported record alone does not authorize messaging.',
  },
  {
    question: 'When stay?',
    answer: 'If the platform and any separately scoped services still match your operating needs. Rejoiner offers software and service options; compare your actual service scope and contract before migrating.',
  },
];
