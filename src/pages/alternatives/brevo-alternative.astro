import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('brevo')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/brevo-alternative';
const title = pageTitle(site, 'alternatives/brevo-alternative');
const desc = description(site, 'alternatives/brevo-alternative');
const faqs = [
  {
    question: 'Why leave Brevo?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Lighter Shopify templates; Advanced ecommerce segmentation limited.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Export consent; rebuild cart; holdout 5%; pause old automations.',
  },
  {
    question: 'Margin during migration?',
    answer: 'Illustrative $625 AOV at 49% margin: $306.25 full-price contribution and $318.75 fixed product cost. An 18% discount leaves $512.50 revenue and $193.75 contribution, a $112.50 loss before other costs.',
  },
  {
    question: 'Timeline?',
    answer: 'Use 1–3 weeks as a planning proposal, not a measured migration benchmark. Allow time for consent and suppression mapping, event checks, parallel-flow collision checks and rollback; schedule cutover only after those checks pass.',
  },
  {
    question: 'SMS pairing?',
    answer: 'Evaluate Postscript or Recart against current Shopify integration and consent requirements before pairing. Verify shared suppression handling and purchase exits with test profiles; the proposed pairing does not establish automatic synchronization or legal compliance.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Suppress recent purchasers; sunset unengaged.',
  },
  {
    question: 'When stay?',
    answer: 'If Budget-conscious stores needing practical campaigns still matches ops.',
  },
];
