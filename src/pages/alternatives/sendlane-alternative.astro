---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('sendlane')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/sendlane-alternative';
const title = pageTitle(site, 'alternatives/sendlane-alternative');
const desc = description(site, 'alternatives/sendlane-alternative');
const faqs = [
  {
    question: 'Why leave Sendlane?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Less transparent self-serve pricing; Best for brands ready to invest.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Export purpose- and channel-specific consent evidence and suppressions; validate identifiers, event mapping and purchase exits; rebuild the cart journey in a test cohort. A proposed 5% holdout needs enough eligible volume and a defined measurement window. Assign one sender per journey before pausing the old automation, and deduplicate queued events during cutover.',
  },
  {
    question: 'Margin during migration?',
    answer: 'Illustrative fixed-cost model: $42 AOV at 51% gross margin leaves $21.42 before discount, with $20.58 product cost. A 17% revenue discount costs $7.14 and leaves $14.28 contribution. Allow separately for messaging, shipping, refunds and platform fees; compare incremental contribution against a holdout rather than attributed revenue alone.',
  },
  {
    question: 'Timeline?',
    answer: 'Use 1–3 weeks only as an illustrative planning window, not a measured typical result or vendor promise. Timing depends on export access, consent evidence, sender setup, event parity, suppression tests and rollback readiness. Move live traffic only after those checks pass.',
  },
  {
    question: 'SMS pairing?',
    answer: 'Assess a specialist such as Postscript or Recart only after verifying current Shopify support, destination coverage, commercial terms and integration requirements. A proposed pairing needs channel-specific permission, shared purchase exits, frequency limits and a single queue owner; shared suppressions alone do not authorize SMS.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Carry suppression and unsubscribe history across systems; preserve the evidence of consent purpose, channel, source and timestamp. Check current permission before every send, suppress purchasers promptly, deduplicate identities and events, and define a sunset policy without silently resubscribing inactive contacts.',
  },
  {
    question: 'When stay?',
    answer: 'Stay if the current setup meets documented event, consent, suppression, reporting and service requirements at an acceptable total cost. Compare a controlled migration proposal with the cost and disruption of staying; verify present features and contract terms directly rather than relying on a generic brand-fit label.',
  },
];
