---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const leaving = appBySlug('drip')!;
const alt2 = appBySlug('recart')!;
const path = '/alternatives/drip-alternative';
const title = pageTitle(site, 'alternatives/drip-alternative');
const desc = description(site, 'alternatives/drip-alternative');
const faqs = [
  {
    question: 'Why leave Drip?',
    answer: 'Pricing, shallow exclusions, or need Sequenzy playbooks. Limits: Smaller ecosystem than Klaviyo; Workflow-heavy for simple needs.',
  },
  {
    question: 'Best alternatives ranked?',
    answer: '1 Sequenzy, then Recart, Postscript, Klaviyo, Omnisend.',
  },
  {
    question: 'Migration checklist?',
    answer: 'Export consent; rebuild cart; holdout 5%; pause old automations.',
  },
  {
    question: 'Margin during migration?',
    answer: 'At $407 AOV and 45% gross margin, full-price contribution is $183.15. A 20% discount gives $325.60 revenue less $223.85 fixed product cost, leaving $101.75 contribution: an $81.40 loss before other variable costs.',
  },
  {
    question: 'Timeline?',
    answer: 'Use 1–3 weeks as a planning proposal, not an observed benchmark or completion guarantee. Consent mapping, event validation and suppression checks determine readiness.',
  },
  {
    question: 'SMS pairing?',
    answer: 'If evaluating Postscript or Recart, verify consent records, purchase exits and cross-tool suppression behavior before enabling SMS. The pairing alone does not establish compliance or prevent duplicate sends.',
  },
  {
    question: 'Data hygiene?',
    answer: 'Suppress recent purchasers; sunset unengaged.',
  },
  {
    question: 'When stay?',
    answer: 'If Teams wanting visual workflows and behavior-based segmentation still matches ops.',
  },
];
