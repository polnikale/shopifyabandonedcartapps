---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { segmentBySlug } from '../../data/segments';
import { appBySlug } from '../../data/apps';

const segment = segmentBySlug('digital-products')!;
const path = '/for/digital-products';
const title = pageTitle(site, 'for/digital-products');
const desc = description(site, 'for/digital-products');
const featuredApps = [appBySlug('sequenzy')!, appBySlug('klaviyo')!, appBySlug('activecampaign')!, appBySlug('drip')!];
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/for" class="link text-sm font-bold">← All store types</a>
      <p class="editorial-kicker mt-6">Cart recovery · digital product shops</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for digital product shops</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">digital product shops lose checkout revenue to delivery, onboarding, cross-sells, and low-inventory constraints. This guide ranks cart recovery apps by timing, margin-safe incentives, and Shopify data depth for Immediate delivery; onboarding critical; cross-sell within 7 days.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Top cart recovery apps" picks={[{ label: 'Best overall', tool: 'Sequenzy', reason: 'Playbook-first recovery with margin math and fast iteration.' }, { label: 'Best Shopify depth', tool: 'Klaviyo', reason: 'Native checkout events and variant segmentation.' }, { label: 'Segment fit', tool: featuredApps[2]?.name || 'Omnisend', reason: segment.pain }]} />
    <div class="prose-shopify">
      <p>Digital Product Shops lose checkout revenue to delivery, onboarding, cross-sells, and low-inventory constraints. Immediate delivery; onboarding critical; cross-sell within 7 days</p>
      <p>Priority workflows: Instant delivery and access emails, Onboarding and activation series, Cross-sell by purchase behavior, Renewal and upgrade paths.</p>
      <h2 class="font-serif text-3xl font-black text-[#24170f] mt-10">Recovery ladder for digital product shops</h2>
      <p>Email 1 at 36 minutes — helpful reminder, no discount. Email 2 at 19 hours — shipping, returns, sizing, or category-specific proof. SMS at 6 hours for TCPA-opted shoppers only. Holdout 5% monthly for incrementality.</p>
      <p><strong>Triggers:</strong> checkout started or cart updated without order. <strong>Exclusions:</strong> recent purchasers, OOS lines, active support tickets, VIP pending offers. <strong>Escalation:</strong> email → SMS → optional push with shared frequency cap (max 3 touches / 7 days).</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('sequenzy')!} rank={1} badge="Top pick" paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'At $70 AOV and 53% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('klaviyo')!} rank={2} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'At $70 AOV and 53% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('activecampaign')!} rank={3} paragraphs={[`${appBySlug('activecampaign')!.shopifyFit}`, 'At $70 AOV and 53% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('drip')!} rank={4} paragraphs={[`${appBySlug('drip')!.shopifyFit}`, 'At $70 AOV and 53% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
    </div>
  </section>
</BaseLayout>
