---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { segmentBySlug } from '../../data/segments';
import { appBySlug } from '../../data/apps';

const segment = segmentBySlug('b2b-wholesale')!;
const path = '/for/b2b-wholesale';
const title = pageTitle(site, 'for/b2b-wholesale');
const desc = description(site, 'for/b2b-wholesale');
const featuredApps = [appBySlug('sequenzy')!, appBySlug('klaviyo')!, appBySlug('activecampaign')!, appBySlug('brevo')!];
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/for" class="link text-sm font-bold">← All store types</a>
      <p class="editorial-kicker mt-6">Cart recovery · B2B wholesale Shopify stores</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for B2B wholesale Shopify stores</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">B2B wholesale Shopify stores lose checkout revenue to account approvals, bulk ordering, and rep follow-up. This guide ranks cart recovery apps by timing, margin-safe incentives, and Shopify data depth for Account-based; approval workflows; bulk reorder cycles.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Top cart recovery apps" picks={[{ label: 'Best overall', tool: 'Sequenzy', reason: 'Playbook-first recovery with margin math and fast iteration.' }, { label: 'Best Shopify depth', tool: 'Klaviyo', reason: 'Native checkout events and variant segmentation.' }, { label: 'Segment fit', tool: featuredApps[2]?.name || 'Omnisend', reason: segment.pain }]} />
    <div class="prose-shopify">
      <p>B2B Wholesale Shopify Stores lose checkout revenue to account approvals, bulk ordering, and rep follow-up. Account-based; approval workflows; bulk reorder cycles</p>
      <p>Priority workflows: Account approval and onboarding, Bulk order reminders, Rep-triggered follow-up, Catalog and MOQ updates.</p>
      <h2 class="font-serif text-3xl font-black text-[#24170f] mt-10">Recovery ladder for B2B wholesale Shopify stores</h2>
      <p>Email 1 at 97 minutes — helpful reminder, no discount. Email 2 at 41 hours — shipping, returns, sizing, or category-specific proof. SMS at 7 hours for TCPA-opted shoppers only. Holdout 5% monthly for incrementality.</p>
      <p><strong>Triggers:</strong> checkout started or cart updated without order. <strong>Exclusions:</strong> recent purchasers, OOS lines, active support tickets, VIP pending offers. <strong>Escalation:</strong> email → SMS → optional push with shared frequency cap (max 3 touches / 7 days).</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('sequenzy')!} rank={1} badge="Top pick" paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'At $534 AOV and 66% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('klaviyo')!} rank={2} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'At $534 AOV and 66% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('activecampaign')!} rank={3} paragraphs={[`${appBySlug('activecampaign')!.shopifyFit}`, 'At $534 AOV and 66% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('brevo')!} rank={4} paragraphs={[`${appBySlug('brevo')!.shopifyFit}`, 'At $534 AOV and 66% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
    </div>
  </section>
</BaseLayout>
