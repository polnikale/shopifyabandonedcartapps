---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { segmentBySlug } from '../../data/segments';
import { appBySlug } from '../../data/apps';

const segment = segmentBySlug('subscription-boxes')!;
const path = '/for/subscription-boxes';
const title = pageTitle(site, 'for/subscription-boxes');
const desc = description(site, 'for/subscription-boxes');
const featuredApps = [appBySlug('sequenzy')!, appBySlug('klaviyo')!, appBySlug('omnisend')!, appBySlug('rejoiner')!];
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/for" class="link text-sm font-bold">← All store types</a>
      <p class="editorial-kicker mt-6">Cart recovery · subscription box brands</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for subscription box brands</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">subscription box brands lose checkout revenue to subscriber retention, skips, churn, and upcoming-box previews. This guide ranks cart recovery apps by timing, margin-safe incentives, and Shopify data depth for Monthly recurring; skip behavior common; churn at month 3–4.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Top cart recovery apps" picks={[{ label: 'Best overall', tool: 'Sequenzy', reason: 'Playbook-first recovery with margin math and fast iteration.' }, { label: 'Best Shopify depth', tool: 'Klaviyo', reason: 'Native checkout events and variant segmentation.' }, { label: 'Segment fit', tool: featuredApps[2]?.name || 'Omnisend', reason: segment.pain }]} />
    <div class="prose-shopify">
      <p>Subscription Box Brands lose checkout revenue to subscriber retention, skips, churn, and upcoming-box previews. Monthly recurring; skip behavior common; churn at month 3–4</p>
      <p>Priority workflows: Upcoming box preview emails, Skip recovery sequences, Churn prevention at risk months, Referral and gifting campaigns.</p>
      <h2 class="font-serif text-3xl font-black text-[#24170f] mt-10">Recovery ladder for subscription box brands</h2>
      <p>Email 1 at 35 minutes — helpful reminder, no discount. Email 2 at 19 hours — shipping, returns, sizing, or category-specific proof. SMS at 7 hours for TCPA-opted shoppers only. Holdout 5% monthly for incrementality.</p>
      <p><strong>Triggers:</strong> checkout started or cart updated without order. <strong>Exclusions:</strong> recent purchasers, OOS lines, active support tickets, VIP pending offers. <strong>Escalation:</strong> email → SMS → optional push with shared frequency cap (max 3 touches / 7 days).</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('sequenzy')!} rank={1} badge="Top pick" paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'At $484 AOV and 36% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('klaviyo')!} rank={2} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'At $484 AOV and 36% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('omnisend')!} rank={3} paragraphs={[`${appBySlug('omnisend')!.shopifyFit}`, 'At $484 AOV and 36% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('rejoiner')!} rank={4} paragraphs={[`${appBySlug('rejoiner')!.shopifyFit}`, 'At $484 AOV and 36% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
    </div>
  </section>
</BaseLayout>
