---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { segmentBySlug } from '../../data/segments';
import { appBySlug } from '../../data/apps';

const segment = segmentBySlug('high-aov')!;
const path = '/for/high-aov';
const title = pageTitle(site, 'for/high-aov');
const desc = description(site, 'for/high-aov');
const featuredApps = [appBySlug('sequenzy')!, appBySlug('klaviyo')!, appBySlug('activecampaign')!, appBySlug('drip')!];
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/for" class="link text-sm font-bold">← All store types</a>
      <p class="editorial-kicker mt-6">Cart recovery · high-AOV stores</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for high-AOV stores</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">high-AOV stores lose checkout revenue to longer consideration, trust, financing, and expert proof. This guide ranks cart recovery apps by timing, margin-safe incentives, and Shopify data depth for 2–16 weeks; multiple touchpoints; financing and warranty decisions.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Top cart recovery apps" picks={[{ label: 'Best overall', tool: 'Sequenzy', reason: 'Playbook-first recovery with margin math and fast iteration.' }, { label: 'Best Shopify depth', tool: 'Klaviyo', reason: 'Native checkout events and variant segmentation.' }, { label: 'Segment fit', tool: featuredApps[2]?.name || 'Omnisend', reason: segment.pain }]} />
    <div class="prose-shopify">
      <p>High-Aov Stores lose checkout revenue to longer consideration, trust, financing, and expert proof. 2–16 weeks; multiple touchpoints; financing and warranty decisions</p>
      <p>Priority workflows: Extended nurture sequences, Expert proof and case studies, Financing and warranty education, Consultation booking follow-up.</p>
      <h2 class="font-serif text-3xl font-black text-[#24170f] mt-10">Recovery ladder for high-AOV stores</h2>
      <p>Email 1 at 43 minutes — helpful reminder, no discount. Email 2 at 39 hours — shipping, returns, sizing, or category-specific proof. SMS at 3 hours for TCPA-opted shoppers only. Holdout 5% monthly for incrementality.</p>
      <p><strong>Triggers:</strong> checkout started or cart updated without order. <strong>Exclusions:</strong> recent purchasers, OOS lines, active support tickets, VIP pending offers. <strong>Escalation:</strong> email → SMS → optional push with shared frequency cap (max 3 touches / 7 days).</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('sequenzy')!} rank={1} badge="Top pick" paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'At $47 AOV and 49% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('klaviyo')!} rank={2} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'At $47 AOV and 49% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('activecampaign')!} rank={3} paragraphs={[`${appBySlug('activecampaign')!.shopifyFit}`, 'At $47 AOV and 49% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
      <ToolReview app={appBySlug('drip')!} rank={4} paragraphs={[`${appBySlug('drip')!.shopifyFit}`, 'At $47 AOV and 49% margin, margin-safe recovery requires conditional incentive branches — not one site-wide cart code.']} />
    </div>
  </section>
</BaseLayout>
