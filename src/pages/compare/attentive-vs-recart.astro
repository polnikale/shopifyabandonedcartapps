---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const a = appBySlug('attentive')!;
const b = appBySlug('recart')!;
const path = '/compare/attentive-vs-recart';
const title = pageTitle(site, 'compare/attentive-vs-recart');
const desc = description(site, 'compare/attentive-vs-recart');
const faqs = [
  {
    question: 'Attentive or Recart for cart recovery?',
    answer: 'Choose Attentive when Larger DTC brands with high SMS volume. Choose Recart when Stores focused on cart recovery via mobile channels.',
  },
  {
    question: 'Unique AOV test for this pair?',
    answer: 'Modeled $553 cart (58% margin) and $677 cart (64% margin) with separate incentive caps.',
  },
  {
    question: 'Channel escalation?',
    answer: 'Email 54m → 38h → SMS 4h; frequency cap 3 touches / 7 days.',
  },
  {
    question: 'Attribution caution?',
    answer: 'Hold out 5%; report contribution after discount, not platform-attributed recovery alone.',
  },
  {
    question: 'Migration tip?',
    answer: 'Rebuild cart flow first; parallel suppressions two weeks; pause old automations before enabling new.',
  },
  {
    question: 'Margin math?',
    answer: '$553 full-price $320.74 vs 19% code $215.67 (Δ $105.07).',
  },
  {
    question: 'Who should choose each?',
    answer: 'Attentive: Attentive fits brands with traffic economics that justify premium SMS programs and managed growth support.… Recart: Recart when abandoned cart recovery is the primary problem and mobile reminders outperform email.…',
  },
  {
    question: 'Workflow test?',
    answer: 'Same four flows: cart, browse, checkout friction, VIP suppress — score trigger accuracy and exclusions.',
  },
];
