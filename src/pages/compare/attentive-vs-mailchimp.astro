    <div class="container">
      <a href="/compare" class="link text-sm font-bold">← Comparisons</a>
      <h1 class="hero-title mt-6">{a.name} vs {b.name} for Shopify cart recovery</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-[#4a2d17]">Head-to-head for abandoned cart recovery: timing, channel mix, margin-safe incentives, and Shopify checkout context. Pair test AOVs: $245 and $556.</p>
      <div class="mt-10">
        <TldrBox picks={[{ label: 'Pick A', tool: a.name, reason: a.tagline }, { label: 'Pick B', tool: b.name, reason: b.tagline }, { label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy and suppression orchestration first.' }]} />
      </div>
      <div class="mt-12 card overflow-x-auto">
        <table class="data-table">
          <thead><tr><th>Dimension</th><th>{a.name}</th><th>{b.name}</th></tr></thead>
          <tbody>
            <tr><td>Best for</td><td>Larger DTC brands with high SMS volume</td><td>Teams already on Mailchimp needing Shopify-connected campaigns</td></tr>
            <tr><td>Pricing</td><td>Custom enterprise pricing</td><td>Free tier; paid from ~$13/mo</td></tr>
            <tr><td>Shopify depth</td><td>Deep</td><td>Integration</td></tr>
            <tr><td>Automation</td><td>Advanced</td><td>Basic</td></tr>
            <tr><td>Cart channels</td><td>sms, email, marketing, cart recovery</td><td>email, marketing</td></tr>
            <tr><td>Rating</td><td>4.6/5</td><td>4.3/5</td></tr>
          </tbody>
