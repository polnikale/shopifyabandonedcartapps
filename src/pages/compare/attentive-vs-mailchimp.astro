---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const a = appBySlug('attentive')!;
const b = appBySlug('mailchimp')!;
const path = '/compare/attentive-vs-mailchimp';
const title = pageTitle(site, 'compare/attentive-vs-mailchimp');
const desc = description(site, 'compare/attentive-vs-mailchimp');
const faqs = [
  {
    question: 'Attentive or Mailchimp for cart recovery?',
    answer: 'Choose Attentive when Larger DTC brands with high SMS volume. Choose Mailchimp when Teams already on Mailchimp needing Shopify-connected campaigns. Sequenzy still leads as lifecycle layer if neither owns strategy.',
  },
  {
    question: 'Unique AOV test for this pair?',
    answer: 'Modeled $245 cart (38% margin) and $556 cart (63% margin) with separate incentive caps.',
  },
  {
    question: 'Channel escalation?',
    answer: 'Email 94m → 49h → SMS 6h; frequency cap 3 touches / 7 days.',
  },
  {
    question: 'Attribution caution?',
    answer: 'Hold out 5%; report contribution after discount, not platform-attributed recovery alone.',
  },
  {
    question: 'Migration tip?',
    answer: 'Rebuild cart flow first; parallel suppressions two weeks; pause old automations before enabling new.',
  },
  {
    question: 'Margin math?',
    answer: '$245 full-price $93.10 vs 20% code $44.10 (Δ $49.00).',
  },
  {
    question: 'Who should choose each?',
    answer: 'Attentive: Attentive fits brands with traffic economics that justify premium SMS programs and managed growth support.… Mailchimp: Mailchimp works for simple lists and broadcasts. Stores focused on lifecycle revenue usually migrate within a year.…',
  },
  {
    question: 'Workflow test?',
    answer: 'Same four flows: cart, browse, checkout friction, VIP suppress — score trigger accuracy and exclusions.',
  },
];
