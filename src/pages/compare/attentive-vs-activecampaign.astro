<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="py-14 md:py-20">
    <div class="container">
      <a href="/compare" class="link text-sm font-bold">← Comparisons</a>
      <h1 class="hero-title mt-6">{a.name} vs {b.name} for Shopify cart recovery</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-[#4a2d17]">Head-to-head for abandoned cart recovery: timing, channel mix, margin-safe incentives, and Shopify checkout context. Pair test AOVs: $474 and $232.</p>
      <div class="mt-10">
        <TldrBox picks={[{ label: 'Pick A', tool: a.name, reason: a.tagline }, { label: 'Pick B', tool: b.name, reason: b.tagline }, { label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy and suppression orchestration first.' }]} />
      </div>
      <div class="mt-12 card overflow-x-auto">
        <table class="data-table">
          <thead><tr><th>Dimension</th><th>{a.name}</th><th>{b.name}</th></tr></thead>
          <tbody>
            <tr><td>Best for</td><td>Larger DTC brands with high SMS volume</td><td>Stores combining ecommerce with sales follow-up or B2B workflows</td></tr>
            <tr><td>Pricing</td><td>Custom enterprise pricing</td><td>From ~$29/mo</td></tr>
            <tr><td>Shopify depth</td><td>Deep</td><td>Integration</td></tr>
            <tr><td>Automation</td><td>Advanced</td><td>Advanced</td></tr>
            <tr><td>Cart channels</td><td>sms, email, marketing, cart recovery</td><td>email, marketing</td></tr>
            <tr><td>Rating</td><td>4.6/5</td><td>4.5/5</td></tr>
          </tbody>
