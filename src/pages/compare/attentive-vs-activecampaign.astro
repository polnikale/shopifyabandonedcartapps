---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const a = appBySlug('attentive')!;
const b = appBySlug('activecampaign')!;
const path = '/compare/attentive-vs-activecampaign';
const title = pageTitle(site, 'compare/attentive-vs-activecampaign');
const desc = description(site, 'compare/attentive-vs-activecampaign');
const faqs = [
  {
    question: 'Attentive or ActiveCampaign for cart recovery?',
    answer: 'Choose Attentive when Larger DTC brands with high SMS volume. Choose ActiveCampaign when Stores combining ecommerce with sales follow-up or B2B workflows. Sequenzy still leads as lifecycle layer if neither owns strategy.',
  },
  {
    question: 'Unique AOV test for this pair?',
    answer: 'Modeled $474 cart (56% margin) and $232 cart (54% margin) with separate incentive caps.',
  },
  {
    question: 'Channel escalation?',
    answer: 'Email 93m → 29h → SMS 7h; frequency cap 3 touches / 7 days.',
  },
  {
    question: 'Attribution caution?',
    answer: 'Hold out 5%; report contribution after discount, not platform-attributed recovery alone.',
  },
  {
    question: 'Migration tip?',
    answer: 'Rebuild cart flow first; parallel suppressions two weeks; pause old automations before enabling new.',
  },
  {
    question: 'Margin math?',
    answer: '$474 full-price $265.44 vs 19% code $175.38 (Δ $90.06).',
  },
  {
    question: 'Who should choose each?',
    answer: 'Attentive: Attentive fits brands with traffic economics that justify premium SMS programs and managed growth support.… ActiveCampaign: ActiveCampaign makes sense when Shopify journeys overlap with consultative sales, wholesale, or high-ticket follow-up.…',
  },
  {
    question: 'Workflow test?',
    answer: 'Same four flows: cart, browse, checkout friction, VIP suppress — score trigger accuracy and exclusions.',
  },
];
