            <tr><td>Shopify depth</td><td>Integration</td><td>Native</td></tr>
            <tr><td>Automation</td><td>Advanced</td><td>Advanced</td></tr>
            <tr><td>Cart channels</td><td>email, marketing</td><td>email, sms, marketing, cart recovery</td></tr>
            <tr><td>Rating</td><td>4.5/5</td><td>4.6/5</td></tr>
