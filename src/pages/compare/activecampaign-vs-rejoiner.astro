<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="py-14 md:py-20">
    <div class="container">
      <a href="/compare" class="link text-sm font-bold">← Comparisons</a>
      <h1 class="hero-title mt-6">{a.name} vs {b.name} for Shopify cart recovery</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-[#4a2d17]">Head-to-head for abandoned cart recovery: timing, channel mix, margin-safe incentives, and Shopify checkout context. Pair test AOVs: $523 and $822.</p>
      <div class="mt-10">
        <TldrBox picks={[{ label: 'Pick A', tool: a.name, reason: a.tagline }, { label: 'Pick B', tool: b.name, reason: b.tagline }, { label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy and suppression orchestration first.' }]} />
      </div>
      <div class="mt-12 card overflow-x-auto">
        <table class="data-table">
