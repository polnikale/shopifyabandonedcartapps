---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('reviews-and-ugc')!;
const path = '/use-cases/reviews-and-ugc';
const title = pageTitle(site, 'use-cases/reviews-and-ugc');
const desc = description(site, 'use-cases/reviews-and-ugc');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for reviews and UGC</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">pull social proof into retention campaigns. Trigger: Post-delivery +7 days; post-purchase satisfaction signals.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'reviews and UGC', reason: 'pull social proof into retention campaigns' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Post-delivery +7 days; post-purchase satisfaction signals</p>
      <p><strong>Timing:</strong> Review request at day 7; UGC showcase in browse abandonment; review highlights in winback</p>
      <p><strong>Exclusions:</strong> High-return SKUs before return window closes; Gift recipients; Products without enough reviews yet</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $709 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('yotpo-email-sms')!} rank={1} paragraphs={[`${appBySlug('yotpo-email-sms')!.shopifyFit}`, 'Workflow test at $709 AOV: pull social proof into retention campaigns']} />
      <ToolReview app={appBySlug('klaviyo')!} rank={2} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $709 AOV: pull social proof into retention campaigns']} />
      <ToolReview app={appBySlug('omnisend')!} rank={3} paragraphs={[`${appBySlug('omnisend')!.shopifyFit}`, 'Workflow test at $709 AOV: pull social proof into retention campaigns']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={4} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $709 AOV: pull social proof into retention campaigns']} />
    </div>
  </section>
</BaseLayout>
