---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('analytics')!;
const path = '/use-cases/analytics';
const title = pageTitle(site, 'use-cases/analytics');
const desc = description(site, 'use-cases/analytics');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for revenue analytics</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">measure incremental revenue, not only attributed clicks. Trigger: Continuous; weekly flow review; monthly cohort analysis.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'revenue analytics', reason: 'measure incremental revenue, not only attributed clicks' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Continuous; weekly flow review; monthly cohort analysis</p>
      <p><strong>Timing:</strong> Compare email-attributed vs holdout where possible; review incrementality quarterly</p>
      <p><strong>Exclusions:</strong> Last-click only attribution; Ignoring margin; Counting would-have-purchased-anyway revenue</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $99 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $99 AOV: measure incremental revenue, not only attributed clicks']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={2} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $99 AOV: measure incremental revenue, not only attributed clicks']} />
      <ToolReview app={appBySlug('drip')!} rank={3} paragraphs={[`${appBySlug('drip')!.shopifyFit}`, 'Workflow test at $99 AOV: measure incremental revenue, not only attributed clicks']} />
      <ToolReview app={appBySlug('sendlane')!} rank={4} paragraphs={[`${appBySlug('sendlane')!.shopifyFit}`, 'Workflow test at $99 AOV: measure incremental revenue, not only attributed clicks']} />
    </div>
  </section>
</BaseLayout>
