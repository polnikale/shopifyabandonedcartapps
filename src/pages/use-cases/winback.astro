---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('winback')!;
const path = '/use-cases/winback';
const title = pageTitle(site, 'use-cases/winback');
const desc = description(site, 'use-cases/winback');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for winback campaigns</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">reactivate customers before they lapse permanently. Trigger: No purchase in 90–180 days depending on category; engaged or unengaged branches.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'winback campaigns', reason: 'reactivate customers before they lapse permanently' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> No purchase in 90–180 days depending on category; engaged or unengaged branches</p>
      <p><strong>Timing:</strong> Email 1 with new arrivals; Email 2 with social proof; Email 3 with incentive only for discount-sensitive segment</p>
      <p><strong>Exclusions:</strong> Active subscribers on replenishment flow; Recent support complaints; One-time gift buyers</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $425 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $425 AOV: reactivate customers before they lapse permanently']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={2} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $425 AOV: reactivate customers before they lapse permanently']} />
      <ToolReview app={appBySlug('drip')!} rank={3} paragraphs={[`${appBySlug('drip')!.shopifyFit}`, 'Workflow test at $425 AOV: reactivate customers before they lapse permanently']} />
      <ToolReview app={appBySlug('omnisend')!} rank={4} paragraphs={[`${appBySlug('omnisend')!.shopifyFit}`, 'Workflow test at $425 AOV: reactivate customers before they lapse permanently']} />
    </div>
  </section>
</BaseLayout>
