---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('browse-abandonment')!;
const path = '/use-cases/browse-abandonment';
const title = pageTitle(site, 'use-cases/browse-abandonment');
const desc = description(site, 'use-cases/browse-abandonment');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for browse abandonment</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">follow product interest without discounting too early. Trigger: Viewed product 2+ times or spent 60+ seconds without add-to-cart.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'browse abandonment', reason: 'follow product interest without discounting too early' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Viewed product 2+ times or spent 60+ seconds without add-to-cart</p>
      <p><strong>Timing:</strong> Email 1 at 4h with social proof; Email 2 at 48h with education; discount only in Email 3 if needed</p>
      <p><strong>Exclusions:</strong> Recent purchasers of same product; Cart abandoners already in cart flow; Out-of-stock products</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $303 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $303 AOV: follow product interest without discounting too early']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={2} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $303 AOV: follow product interest without discounting too early']} />
      <ToolReview app={appBySlug('drip')!} rank={3} paragraphs={[`${appBySlug('drip')!.shopifyFit}`, 'Workflow test at $303 AOV: follow product interest without discounting too early']} />
      <ToolReview app={appBySlug('omnisend')!} rank={4} paragraphs={[`${appBySlug('omnisend')!.shopifyFit}`, 'Workflow test at $303 AOV: follow product interest without discounting too early']} />
    </div>
  </section>
</BaseLayout>
