---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('loyalty')!;
const path = '/use-cases/loyalty';
const title = pageTitle(site, 'use-cases/loyalty');
const desc = description(site, 'use-cases/loyalty');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for loyalty campaigns</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">convert repeat buyers into habitual customers. Trigger: Points earned, tier achieved, or milestone order count.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'loyalty campaigns', reason: 'convert repeat buyers into habitual customers' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Points earned, tier achieved, or milestone order count</p>
      <p><strong>Timing:</strong> Welcome to loyalty on 2nd order; tier celebration immediate; expiring points at 30 days before</p>
      <p><strong>Exclusions:</strong> Discount-only one-time buyers; Wholesale accounts; Employees</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $295 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('marsello')!} rank={1} paragraphs={[`${appBySlug('marsello')!.shopifyFit}`, 'Workflow test at $295 AOV: convert repeat buyers into habitual customers']} />
      <ToolReview app={appBySlug('yotpo-email-sms')!} rank={2} paragraphs={[`${appBySlug('yotpo-email-sms')!.shopifyFit}`, 'Workflow test at $295 AOV: convert repeat buyers into habitual customers']} />
      <ToolReview app={appBySlug('klaviyo')!} rank={3} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $295 AOV: convert repeat buyers into habitual customers']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={4} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $295 AOV: convert repeat buyers into habitual customers']} />
    </div>
  </section>
</BaseLayout>
