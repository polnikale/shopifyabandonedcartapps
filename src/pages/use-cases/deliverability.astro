---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('deliverability')!;
const path = '/use-cases/deliverability';
const title = pageTitle(site, 'use-cases/deliverability');
const desc = description(site, 'use-cases/deliverability');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for deliverability</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">protect inbox placement while sending more lifecycle email. Trigger: Ongoing monitoring of bounce, complaint, and engagement rates.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'deliverability', reason: 'protect inbox placement while sending more lifecycle email' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Ongoing monitoring of bounce, complaint, and engagement rates</p>
      <p><strong>Timing:</strong> Weekly deliverability check; sunset unengaged at 90–180 days; warm new domains gradually</p>
      <p><strong>Exclusions:</strong> Purchased lists; Re-engaging spam complainers; Sudden volume spikes without warm-up</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $716 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $716 AOV: protect inbox placement while sending more lifecycle email']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={2} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $716 AOV: protect inbox placement while sending more lifecycle email']} />
      <ToolReview app={appBySlug('sendlane')!} rank={3} paragraphs={[`${appBySlug('sendlane')!.shopifyFit}`, 'Workflow test at $716 AOV: protect inbox placement while sending more lifecycle email']} />
      <ToolReview app={appBySlug('brevo')!} rank={4} paragraphs={[`${appBySlug('brevo')!.shopifyFit}`, 'Workflow test at $716 AOV: protect inbox placement while sending more lifecycle email']} />
    </div>
  </section>
</BaseLayout>
