---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('email-design')!;
const path = '/use-cases/email-design';
const title = pageTitle(site, 'use-cases/email-design');
const desc = description(site, 'use-cases/email-design');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for email design</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">make product-led campaigns readable and mobile-friendly. Trigger: All campaign and flow sends.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'email design', reason: 'make product-led campaigns readable and mobile-friendly' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> All campaign and flow sends</p>
      <p><strong>Timing:</strong> Mobile-first design; test on iOS Mail and Gmail app before every launch</p>
      <p><strong>Exclusions:</strong> Desktop-only templates; Image-heavy emails without alt text; Tiny tap targets on mobile</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $104 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $104 AOV: make product-led campaigns readable and mobile-friendly']} />
      <ToolReview app={appBySlug('omnisend')!} rank={2} paragraphs={[`${appBySlug('omnisend')!.shopifyFit}`, 'Workflow test at $104 AOV: make product-led campaigns readable and mobile-friendly']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={3} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $104 AOV: make product-led campaigns readable and mobile-friendly']} />
      <ToolReview app={appBySlug('shopify-email')!} rank={4} paragraphs={[`${appBySlug('shopify-email')!.shopifyFit}`, 'Workflow test at $104 AOV: make product-led campaigns readable and mobile-friendly']} />
    </div>
  </section>
</BaseLayout>
