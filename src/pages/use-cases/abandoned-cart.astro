---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('abandoned-cart')!;
const path = '/use-cases/abandoned-cart';
const title = pageTitle(site, 'use-cases/abandoned-cart');
const desc = description(site, 'use-cases/abandoned-cart');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for abandoned cart recovery</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">bring shoppers back before intent disappears. Trigger: Added to cart without checkout completion within 1–4 hours.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'abandoned cart recovery', reason: 'bring shoppers back before intent disappears' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Added to cart without checkout completion within 1–4 hours</p>
      <p><strong>Timing:</strong> Email 1 at 1h; Email 2 at 24h; SMS at 4h if opted in; stop on purchase</p>
      <p><strong>Exclusions:</strong> Recent purchasers; Out-of-stock items in cart; Customers in active support case; VIP segments with better offers pending</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $370 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $370 AOV: bring shoppers back before intent disappears']} />
      <ToolReview app={appBySlug('omnisend')!} rank={2} paragraphs={[`${appBySlug('omnisend')!.shopifyFit}`, 'Workflow test at $370 AOV: bring shoppers back before intent disappears']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={3} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $370 AOV: bring shoppers back before intent disappears']} />
      <ToolReview app={appBySlug('postscript')!} rank={4} paragraphs={[`${appBySlug('postscript')!.shopifyFit}`, 'Workflow test at $370 AOV: bring shoppers back before intent disappears']} />
    </div>
  </section>
</BaseLayout>
