---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('replenishment')!;
const path = '/use-cases/replenishment';
const title = pageTitle(site, 'use-cases/replenishment');
const desc = description(site, 'use-cases/replenishment');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for replenishment reminders</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">time repeat purchases around actual product usage. Trigger: Days since last purchase of consumable SKU exceeds usage window.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'replenishment reminders', reason: 'time repeat purchases around actual product usage' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Days since last purchase of consumable SKU exceeds usage window</p>
      <p><strong>Timing:</strong> Reminder at 80% of expected consumption; follow-up at 100%; subscription upsell at 120%</p>
      <p><strong>Exclusions:</strong> Customers who already reordered; Subscription active on same SKU; Products with irregular usage patterns</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $101 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $101 AOV: time repeat purchases around actual product usage']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={2} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $101 AOV: time repeat purchases around actual product usage']} />
      <ToolReview app={appBySlug('omnisend')!} rank={3} paragraphs={[`${appBySlug('omnisend')!.shopifyFit}`, 'Workflow test at $101 AOV: time repeat purchases around actual product usage']} />
      <ToolReview app={appBySlug('drip')!} rank={4} paragraphs={[`${appBySlug('drip')!.shopifyFit}`, 'Workflow test at $101 AOV: time repeat purchases around actual product usage']} />
    </div>
  </section>
</BaseLayout>
