---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('back-in-stock')!;
const path = '/use-cases/back-in-stock';
const title = pageTitle(site, 'use-cases/back-in-stock');
const desc = description(site, 'use-cases/back-in-stock');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for back-in-stock alerts</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">capture demand for unavailable products. Trigger: Inventory restocked for waitlisted SKU or variant.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'back-in-stock alerts', reason: 'capture demand for unavailable products' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Inventory restocked for waitlisted SKU or variant</p>
      <p><strong>Timing:</strong> Immediate on restock; priority by waitlist signup order; expire after 48h</p>
      <p><strong>Exclusions:</strong> Customers who bought substitute; Waitlist for discontinued products; Variants still partially OOS</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $311 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $311 AOV: capture demand for unavailable products']} />
      <ToolReview app={appBySlug('privy')!} rank={2} paragraphs={[`${appBySlug('privy')!.shopifyFit}`, 'Workflow test at $311 AOV: capture demand for unavailable products']} />
      <ToolReview app={appBySlug('omnisend')!} rank={3} paragraphs={[`${appBySlug('omnisend')!.shopifyFit}`, 'Workflow test at $311 AOV: capture demand for unavailable products']} />
      <ToolReview app={appBySlug('firepush')!} rank={4} paragraphs={[`${appBySlug('firepush')!.shopifyFit}`, 'Workflow test at $311 AOV: capture demand for unavailable products']} />
    </div>
  </section>
</BaseLayout>
