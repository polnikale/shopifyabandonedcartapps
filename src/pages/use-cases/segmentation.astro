---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('segmentation')!;
const path = '/use-cases/segmentation';
const title = pageTitle(site, 'use-cases/segmentation');
const desc = description(site, 'use-cases/segmentation');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for Shopify segmentation</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">target by behavior, products, order count, and lifecycle stage. Trigger: Continuous based on Shopify events and profile properties.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'Shopify segmentation', reason: 'target by behavior, products, order count, and lifecycle stage' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Continuous based on Shopify events and profile properties</p>
      <p><strong>Timing:</strong> Real-time segment updates; weekly segment audits; quarterly RFM recalculation</p>
      <p><strong>Exclusions:</strong> Overlapping segments without priority rules; Stale segments not reviewed; Segments without defined actions</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $712 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $712 AOV: target by behavior, products, order count, and lifecycle stage']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={2} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $712 AOV: target by behavior, products, order count, and lifecycle stage']} />
      <ToolReview app={appBySlug('drip')!} rank={3} paragraphs={[`${appBySlug('drip')!.shopifyFit}`, 'Workflow test at $712 AOV: target by behavior, products, order count, and lifecycle stage']} />
      <ToolReview app={appBySlug('activecampaign')!} rank={4} paragraphs={[`${appBySlug('activecampaign')!.shopifyFit}`, 'Workflow test at $712 AOV: target by behavior, products, order count, and lifecycle stage']} />
    </div>
  </section>
</BaseLayout>
