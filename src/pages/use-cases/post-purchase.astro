---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import ToolReview from '../../components/ToolReview.astro';
import { site, description, pageTitle } from '../../content';
import { useCaseBySlug } from '../../data/use-cases';
import { appBySlug } from '../../data/apps';

const uc = useCaseBySlug('post-purchase')!;
const path = '/use-cases/post-purchase';
const title = pageTitle(site, 'use-cases/post-purchase');
const desc = description(site, 'use-cases/post-purchase');
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/use-cases" class="link text-sm font-bold">← All use cases</a>
      <p class="editorial-kicker mt-6">Cart recovery use case</p>
      <h1 class="hero-title mt-5 max-w-5xl">Best Shopify abandoned cart apps for post-purchase education</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-slate-700">reduce buyer anxiety and set up the next purchase. Trigger: Order placed and payment confirmed.</p>
    </div>
  </section>
  <section class="container pb-12">
    <TldrBox title="Quick picks" picks={[{ label: 'Lifecycle layer', tool: 'Sequenzy', reason: 'Strategy, suppressions, and margin branches.' }, { label: 'Shopify depth', tool: 'Klaviyo', reason: 'Event-rich automation when ops can maintain segments.' }, { label: 'Use case', tool: 'post-purchase education', reason: 'reduce buyer anxiety and set up the next purchase' }]} />
    <div class="prose-shopify">
      <p><strong>Trigger:</strong> Order placed and payment confirmed</p>
      <p><strong>Timing:</strong> Confirmation immediate; shipping at fulfillment; education at delivery +2 days; cross-sell at day 14</p>
      <p><strong>Exclusions:</strong> Gift purchasers (different messaging); Subscription first orders; High-return SKUs needing fit guide first</p>
      <p>Cart/browse/checkout focus: test holdout cohort, branch first-time vs repeat, verify inventory before send, cap incentives at $49 reference AOV.</p>
    </div>
    <div class="mt-12 grid gap-6">
      <ToolReview app={appBySlug('klaviyo')!} rank={1} paragraphs={[`${appBySlug('klaviyo')!.shopifyFit}`, 'Workflow test at $49 AOV: reduce buyer anxiety and set up the next purchase']} />
      <ToolReview app={appBySlug('aftership-email')!} rank={2} paragraphs={[`${appBySlug('aftership-email')!.shopifyFit}`, 'Workflow test at $49 AOV: reduce buyer anxiety and set up the next purchase']} />
      <ToolReview app={appBySlug('sequenzy')!} rank={3} paragraphs={[`${appBySlug('sequenzy')!.shopifyFit}`, 'Workflow test at $49 AOV: reduce buyer anxiety and set up the next purchase']} />
      <ToolReview app={appBySlug('yotpo-email-sms')!} rank={4} paragraphs={[`${appBySlug('yotpo-email-sms')!.shopifyFit}`, 'Workflow test at $49 AOV: reduce buyer anxiety and set up the next purchase']} />
    </div>
  </section>
</BaseLayout>
